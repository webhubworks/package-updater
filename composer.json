{
    "name": "webhubworks/package-updater",
    "description": "Bulk-update Composer packages (and Craft / Craft plugins) across all your local repos.",
    "keywords": ["framework", "laravel", "laravel zero", "console", "cli", "composer", "craft"],
    "homepage": "https://webhub.de",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/webhubworks/package-updater/issues",
        "source": "https://github.com/webhubworks/package-updater"
    },
    "authors": [
        {
            "name": "Marven Thieme",
            "email": "thieme@webhub.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel-zero/framework": "^12.0.2"
    },
    "require-dev": {
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2"
    },
    "autoload": {
        "psr-4": {
            "PackageUpdater\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["package-updater", "pu"]
}
